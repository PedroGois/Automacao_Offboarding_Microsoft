SIGO_DOCUMENT=your-sigo-document
SIGO_PASSWORD=your-sigo-password

AZURE_TENANT_ID=your-azure-tenant-id
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret

# Necessários somente para converter caixas compartilhadas via Exchange Online.
# O certificado precisa estar instalado neste Windows e registrado no mesmo app do Entra ID.
EXCHANGE_ORGANIZATION=your-tenant.onmicrosoft.com
AZURE_CERTIFICATE_THUMBPRINT=your-certificate-thumbprint